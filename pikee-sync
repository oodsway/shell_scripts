#!/usr/bin/env bash

# Author: Woods Wannamaker
# Date: 2024-11-28
# System: Pi5 running self-hosted Unifi Network Application
# Purpose: rsync unifi configs (*.unf) from unifi controller to targets
# Source: https://forums.lawrencesystems.com/
#------------------------------------------------------------------------------
# Change Log: 2026-10-11 post upgrade to ubuntu server 26.04.1 LTS
# Use of .local hostnames required. Manual confirmation in ssh required 1x
# Replaced nc test with timeout test for network sync with knix & pishare.
# Replaced -avrhiO with -rlptDvrhiO which is handled via samba mount on pikee
#------------------------------------------------------------------------------

push_update()
{

# sync pikee self-hosted to /media/shared/_unifi_backups (local samba share)
rsync -rlptDvrhiO --no-perms --delete --progress --stats /var/lib/unifi/backup/autobackup/ \
/media/shared/_unifi_backups/

# conditional sync to pishare.local/_unifi_backups via ssh
if timeout 3 bash -c 'cat < /dev/null > /dev/tcp/pishare.local/22' 2>/dev/null; then
rsync -avrhiO --no-perms --delete --progress --stats /var/lib/unifi/backup/autobackup/ \
-e ssh woods@pishare.local:/media/SDshare/_unifi_backups/ 2>/dev/null
fi

# conditional sync to knix.local at /media/woods/Data/_unifi_backups via ssh
if timeout 3 bash -c 'cat < /dev/null > /dev/tcp/knix.local/22' 2>/dev/null; then
rsync -avrhiO --no-perms --delete --progress --stats /var/lib/unifi/backup/autobackup/ \
-e ssh woods@knix.local:/media/woods/Data/_unifi_backups/
fi

}

push_update

chown woods:woods /media/shared/_unifi_backups/
